rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The dashboard is publicly readable so the staff-room screen can show it.
    // Only the configured administrator may create or update the shared dashboard.
    match /siteData/main {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "vNazaWZ5jKaZItnrlM0hRPGT2hd2";
    }
  }
}
